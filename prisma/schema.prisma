// Prisma-Schema für "NextGen IT-Ausbildung"
// Naming: camelCase in Prisma, snake_case in DB via @map (siehe DB-Regeln).
// UUID-Primary-Keys, synchronize: false (Migrations only).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider             = "postgresql"
  url                  = env("DATABASE_URL")
  shadowDatabaseUrl    = env("SHADOW_DATABASE_URL")
}

enum Role {
  azubi
  ausbildungsbeauftragter
  ausbilder
  hr
  admin
}

enum ReportStatus {
  entwurf
  eingereicht
  in_pruefung
  visiert
  archiviert
}

enum ReportTyp {
  betrieb
  berufsschule
  schulung
}

enum AbwesenheitTyp {
  urlaub
  krank
  berufsschule
}

enum AbwesenheitQuelle {
  manuell
  personio
  ical
}

enum FeedbackTyp {
  abteilungsbewertung
  azubi_feedback
}

enum AiDocumentStatus {
  importiert
  vektorisiert
  fehler
}

enum ProjektStatus {
  entwurf
  eingereicht
  in_pruefung
  freigegeben
  abgelehnt
  archiviert
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique @map("email")
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  isActive     Boolean  @default(true) @map("is_active")
  azubiId      String?  @unique @map("azubi_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roles      UserRole[]
  abteilungen Abteilung[] @relation("AbteilungVerantwortliche")
  einsaetze  Einsatz[]   @relation("EinsatzAzubi")
  berichte   Report[]
  kommentare ReportComment[]
  zertifikate Zertifikat[]
  abwesenheiten Abwesenheit[]
  noten      Grade[]
  bewerteteNoten Grade[] @relation("GradeBewertetVon")
  feedbackGegeben Feedback[] @relation("FeedbackVon")
  feedbackErhalten Feedback[] @relation("FeedbackAn")
  badges     UserBadge[]
  checklisten Checklist[]
  projekte   Projekt[]
  pruefungen Pruefung[]
  auditEvents AuditEvent[]
  mfaSecret    String?                @map("mfa_secret")
  mfaActive    Boolean                @default(false) @map("mfa_active")

  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  datenschutzRequests     DatenschutzRequest[]
  ausbildungsplaeneAzubi Ausbildungsplan[] @relation("AusbildungsplanAzubi")
  ausbildungsplaeneAusbilder Ausbildungsplan[] @relation("AusbildungsplanAusbilder")
  ausbildungsvertrag Ausbildungsvertrag?
  erziehungsberechtigte Erziehungsberechtigter[]
  feedbackGespraecheAzubi FeedbackGespraech[] @relation("FeedbackGespraechAzubi")
  feedbackGespraecheDurchfuehrer FeedbackGespraech[] @relation("FeedbackGespraechDurchfuehrer")
  gradeEntries GradeEntry[] @relation("GradeEntryAzubi")
  foerderbedarfe Foerderbedarf[] @relation("FoerderbedarfAzubi")
  uebernahmeGespraeche UebernahmeGespraech[] @relation("UebernahmeAzubi")
  alumni Alumni?
  versetzungswuensche Versetzungswunsch[]
  consents                Consent[]
  consentLogs             ConsentLog[]
  skillAssignments        SkillAssignment[] @relation("SkillAssignmentAzubi")
  lernpfad                Lernpfad[]        @relation("LernpfadAzubi")
  lernpfadErstellt        Lernpfad[]        @relation("LernpfadErsteller")
  nachweisKommentare      AusbildungsnachweisKommentar[] @relation("AusbildungsnachweisKommentarAuthor")
  datenportabilitaet      Datenportabilitaet[]
  unterrichtsstunden      Unterrichtsstunde[]
  benutzerspezifischeAlertKonfigurationen BenutzerspezifischeAlertKonfiguration[]

  @@index([azubiId], map: "idx_users_azubi_id")
  @@map("users")
}

model UserRole {
  id     String @id @default(uuid())
  userId String @map("user_id")
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_roles_user_id")
  @@index([role], map: "idx_user_roles_role")
  @@map("user_roles")
}

model Abteilung {
   id          String  @id @default(uuid())
   name        String
   kurzzeichen String? @map("kurzzeichen")
   beschreibung String? @map("beschreibung")
   standortId  String? @map("standort_id")
   standort    Standort? @relation(fields: [standortId], references: [id])
   createdAt   DateTime @default(now()) @map("created_at")
   updatedAt   DateTime @updatedAt @map("updated_at")

   verantwortliche User[] @relation("AbteilungVerantwortliche")
   einsaetze      Einsatz[]
   feedback       Feedback[]

   @@map("abteilungen")
}

model Einsatz {
  id           String   @id @default(uuid())
  azubiId      String   @map("azubi_id")
  abteilungId  String   @map("abteilung_id")
  von          DateTime
  bis          DateTime
  skillLevel   Int      @default(0) @map("skill_level")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  azubi     User      @relation("EinsatzAzubi", fields: [azubiId], references: [id], onDelete: Cascade)
  abteilung Abteilung @relation(fields: [abteilungId], references: [id], onDelete: Cascade)

  @@index([azubiId], map: "idx_einsatz_azubi_id")
  @@index([abteilungId], map: "idx_einsatz_abteilung_id")
  @@index([von, bis], map: "idx_einsatz_von_bis")
  @@map("einsatz")
}

model Framework {
  id          String   @id @default(uuid())
  titel       String
  lernfeld    String
  kompetenz   String
  beschreibung String?
  quelle      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  courses Course[]
  tasks   Task[]
  skillAssignments SkillAssignment[]
  benchmarks       SkillMatrixBenchmark[]

  @@index([lernfeld], map: "idx_framework_lernfeld")
  @@map("frameworks")
}

model Course {
  id              String   @id @default(uuid())
  frameworkId     String   @map("framework_id")
  titel           String
  beschreibung    String?
  lernziele       String[]
  theorie         String?
  freigegeben     Boolean  @default(false)
  kiGeneriert     Boolean  @default(false) @map("ki_generiert")
  qualitaetsScore Int?     @map("qualitaets_score")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  framework Framework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  tasks    Task[]
  grades   Grade[]
  skillAssignments SkillAssignment[]
  lernpfad         Lernpfad[]

  @@index([frameworkId], map: "idx_course_framework_id")
  @@index([freigegeben], map: "idx_course_freigegeben")
  @@map("courses")
}

model Task {
  id            String   @id @default(uuid())
  frameworkId   String   @map("framework_id")
  courseId      String?  @map("course_id")
  titel         String
  beschreibung  String?
  musterloesung String?  @map("musterloesung")
  freigegeben   Boolean  @default(false)
  kiGeneriert   Boolean  @default(false) @map("ki_generiert")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  framework Framework  @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  course    Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  reportTasks ReportTask[]

  @@index([frameworkId], map: "idx_task_framework_id")
  @@index([courseId], map: "idx_task_course_id")
  @@map("tasks")
}

model Report {
  id              String       @id @default(uuid())
  azubiId         String       @map("azubi_id")
  titel           String
  typ             ReportTyp
  kalenderwoche   Int          @map("kalenderwoche")
  jahr            Int
  datumVon       DateTime     @map("datum_von")
  datumBis       DateTime     @map("datum_bis")
  inhaltMarkdown  String       @map("inhalt_markdown")
  status          ReportStatus @default(entwurf)
  signiertVon     String?      @map("signiert_von")
  signiertAm      DateTime?    @map("signiert_am")
  archiviertAm    DateTime?    @map("archiviert_am")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  azubi      User           @relation(fields: [azubiId], references: [id], onDelete: Cascade)
  reportTasks ReportTask[]
  kommentare ReportComment[]
  attachments ReportAttachment[]
   versions ReportVersion[]
   timeEntries ReportTimeEntry[]
   ausbildungsnachweisId String? @map("ausbildungsnachweis_id")

   @@index([azubiId], map: "idx_report_azubi_id")
  @@index([status], map: "idx_report_status")
  @@index([jahr, kalenderwoche], map: "idx_report_jahr_kw")
  @@map("reports")
}

model ReportTask {
  id          String   @id @default(uuid())
  reportId    String   @map("report_id")
  taskId      String   @map("task_id")
  kommentar   String?
  createdAt   DateTime @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([reportId, taskId], map: "uq_report_task")
  @@index([reportId], map: "idx_report_task_report_id")
  @@index([taskId], map: "idx_report_task_task_id")
  @@map("report_tasks")
}

model ReportComment {
  id        String   @id @default(uuid())
  reportId  String   @map("report_id")
  authorId  String   @map("author_id")
  text      String
  art       String   @default("bemerkung")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([reportId], map: "idx_report_comment_report_id")
  @@map("report_comments")
}

model AiDocument {
  id        String          @id @default(uuid())
  filename  String
  quelle    String?
  inhalt    String
  status    AiDocumentStatus @default(importiert)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  chunks AiDocumentChunk[]

  @@map("ai_documents")
}

model AiDocumentChunk {
  id          String   @id @default(uuid())
  documentId  String   @map("document_id")
  inhalt      String
  embedding   Float[]  @map("embedding")
  createdAt   DateTime @default(now()) @map("created_at")

  document AiDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId], map: "idx_ai_chunk_document_id")
  @@map("ai_document_chunks")
}

model Zertifikat {
  id          String   @id @default(uuid())
  azubiId     String   @map("azubi_id")
  titel       String
  aussteller  String
  erworbenAm  DateTime @map("erworben_am")
  dokumentUrl String?  @map("dokument_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  azubi User @relation(fields: [azubiId], references: [id], onDelete: Cascade)

  @@index([azubiId], map: "idx_zertifikat_azubi_id")
  @@map("zertifikate")
}

model Abwesenheit {
  id        String           @id @default(uuid())
  azubiId   String           @map("azubi_id")
   typ            AbwesenheitTyp
   quelle         AbwesenheitQuelle @default(manuell)
   von            DateTime
   bis            DateTime
   urlaubsanspruch Float @default(0) @map("urlaubsanspruch")
   notiz          String?
   createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  azubi User @relation(fields: [azubiId], references: [id], onDelete: Cascade)

  @@index([azubiId], map: "idx_abwesenheit_azubi_id")
  @@index([von, bis], map: "idx_abwesenheit_von_bis")
  @@map("abwesenheiten")
}

model Checklist {
  id        String   @id @default(uuid())
  azubiId   String   @map("azubi_id")
  titel     String
  erledigt  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  azubi  User           @relation(fields: [azubiId], references: [id], onDelete: Cascade)
  items  ChecklistItem[]

  @@index([azubiId], map: "idx_checklist_azubi_id")
  @@map("checklisten")
}

model ChecklistItem {
  id          String   @id @default(uuid())
  checklistId String   @map("checklist_id")
  text        String
  erledigt    Boolean  @default(false)
  reihenfolge Int      @default(0) @map("reihenfolge")
  createdAt   DateTime @default(now()) @map("created_at")

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId], map: "idx_checklist_item_checklist_id")
  @@map("checklist_items")
}

model Feedback {
  id          String      @id @default(uuid())
  vonUserId   String      @map("von_user_id")
  anUserId    String?     @map("an_user_id")
  abteilungId String?     @map("abteilung_id")
  typ         FeedbackTyp
  fachkompetenz Int?      @map("fachkompetenz")
  softskills  Int?        @map("softskills")
  kommentar   String?
  createdAt   DateTime    @default(now()) @map("created_at")

  vonUser   User        @relation("FeedbackVon", fields: [vonUserId], references: [id], onDelete: Cascade)
  anUser    User?       @relation("FeedbackAn", fields: [anUserId], references: [id], onDelete: SetNull)
  abteilung Abteilung?  @relation(fields: [abteilungId], references: [id], onDelete: SetNull)

  @@index([vonUserId], map: "idx_feedback_von_user_id")
  @@index([anUserId], map: "idx_feedback_an_user_id")
  @@map("feedback")
}

model WikiPage {
  id          String   @id @default(uuid())
  titel       String
  slug        String   @unique
  kategorie   String?
  inhaltMarkdown String @map("inhalt_markdown")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([kategorie], map: "idx_wiki_kategorie")
  @@map("wiki_pages")
}

enum GradeStatus {
  entwurf
  bestaetigt
  visiert
  archiviert
}

enum Halbjahr {
  erstes
  zweites
}

enum Pruefungsart {
  schriftlich
  muendlich
  projektarbeit
  sonstige
}

enum GradeTyp {
  note
  zertifikat
  projekt
  versetzungszeugnis
}

enum Gewichtungskategorie {
  schulisch
  berufsschulisch
  betrieblich
  ihk_pruefung
}

model Grade {
  id              String        @id @default(uuid())
  azubiId         String        @map("azubi_id")
  fach            String
  note            Float
  zeitraum        String
  halbjahr        Halbjahr?     @map("halbjahr")
  datum           DateTime?     @map("datum")
  pruefungsart    Pruefungsart? @map("pruefungsart")
  gewichtung      Float?        @default(1.0)
  gewichtungsKategorie Gewichtungskategorie? @map("gewichtungs_kategorie")
  typ             GradeTyp      @default(note)
  status          GradeStatus   @default(entwurf)
  beschreibung    String?
  bemerkungen     String?       @map("bemerkungen")
  prueferId       String?       @map("pruefer_id")
  pruefungsdatum  DateTime?     @map("pruefungsdatum")
  wiederholung    Boolean       @default(false) @map("wiederholung")
  maßnahme        String?
  zeugnisUrl      String?       @map("zeugnis_url")
  quellenUrl      String?       @map("quellen_url")
  kursId          String?       @map("kurs_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  bewertetVon     String?       @map("bewertet_von")
  bewertetAm      DateTime?     @map("bewertet_am")
  bewertung       String?       @map("bewertung")

  azubi User @relation(fields: [azubiId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [kursId], references: [id], onDelete: SetNull)
  bewertetVonUser User[] @relation("GradeBewertetVon")
  gradeVersions GradeVersion[]

  @@index([azubiId], map: "idx_grade_azubi_id")
  @@index([fach], map: "idx_grade_fach")
  @@index([status], map: "idx_grade_status")
  @@index([typ], map: "idx_grade_typ")
  @@index([datum], map: "idx_grade_datum")
  @@map("grades")
}

model GradeVersion {
  id          String   @id @default(uuid())
  gradeId     String   @map("grade_id")
  version     Int
  fach        String
  note        Float
  status      GradeStatus
  zeitraum    String
  halbjahr    Halbjahr? @map("halbjahr")
  datum       DateTime? @map("datum")
  pruefungsart Pruefungsart? @map("pruefungsart")
  gewichtung  Float?   @default(1.0)
  gewichtungsKategorie Gewichtungskategorie? @map("gewichtungs_kategorie")
  typ         GradeTyp @default(note)
  bemerkungen String?
  prueferId   String?  @map("pruefer_id")
  pruefungsdatum DateTime? @map("pruefungsdatum")
  wiederholung Boolean  @default(false) @map("wiederholung")
  maßnahme    String?
  zeugnisUrl  String?  @map("zeugnis_url")
  bewertetVon String?  @map("bewertet_von")
  bewertetAm  DateTime? @map("bewertet_am")
  erstelltVon String?  @map("erstellt_von")
  createdAt   DateTime @default(now()) @map("created_at")

  grade Grade @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@index([gradeId], map: "idx_gradeversion_grade_id")
  @@index([version], map: "idx_gradeversion_version")
  @@map("grade_versions")
}

model Badge {
  id           String   @id @default(uuid())
  schluessel   String   @unique @map("schluessel")
  titel        String
  beschreibung String?
  icon         String?
  createdAt    DateTime @default(now()) @map("created_at")

  userBadges UserBadge[]
  standortspezifischeBadges StandortspezifischeBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(uuid())
  azubiId   String   @map("azubi_id")
  badgeId   String   @map("badge_id")
  earnedAt  DateTime @default(now()) @map("earned_at")

  azubi User @relation(fields: [azubiId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([azubiId, badgeId], map: "uq_user_badge")
  @@index([azubiId], map: "idx_user_badge_azubi_id")
  @@map("user_badges")
}

model Projekt {
  id             String        @id @default(uuid())
  azubiId        String        @map("azubi_id")
  titel          String
  beschreibung   String?       @map("beschreibung")
  projektantrag  String?       @map("projektantrag")
  projektdoku    String?       @map("projektdoku")
  status         ProjektStatus @default(entwurf)
  bewertung      String?
  bewertetVon    String?       @map("bewertet_von")
  bewertetAm     DateTime?     @map("bewertet_am")
  freigegeben    Boolean       @default(false)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  azubi User @relation(fields: [azubiId], references: [id], onDelete: Cascade)

  @@index([azubiId], map: "idx_projekt_azubi_id")
  @@index([status], map: "idx_projekt_status")
  @@map("projekte")
}

model AuditEvent {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  details   String?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_audit_user_id")
  @@index([action], map: "idx_audit_action")
  @@index([createdAt], map: "idx_audit_created_at")
  @@map("audit_events")
}

enum PruefungTyp {
  ap1
  ap2
}

enum PruefungsStatus {
  angemeldet
  teilgenommen
  bestanden
  wiederholung
}

model Pruefung {
  id           String            @id @default(uuid())
  azubiId      String            @map("azubi_id")
  typ          PruefungTyp
  status       PruefungsStatus   @default(angemeldet)
  ihkTermin    DateTime?         @map("ihk_termin")
  beschreibung String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  azubi        User              @relation(fields: [azubiId], references: [id], onDelete: Cascade)
  meilensteine PruefungsMeilenstein[]

  @@index([azubiId], map: "idx_pruefung_azubi_id")
  @@index([typ], map: "idx_pruefung_typ")
  @@index([status], map: "idx_pruefung_status")
  @@map("pruefungen")
}

model PruefungsMeilenstein {
  id              String    @id @default(uuid())
  pruefungId      String    @map("pruefung_id")
  titel           String
  beschreibung    String?
  faelligAm       DateTime? @map("faellig_am")
  erledigt        Boolean   @default(false)
  erledigtAm      DateTime? @map("erledigt_am")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  pruefung Pruefung @relation(fields: [pruefungId], references: [id], onDelete: Cascade)

  @@index([pruefungId], map: "idx_pm_pruefung_id")
  @@map("pruefungs_meilensteine")
}

enum NotificationCategory {
  review
  deadline
  reminder
  absence
  system
}

enum NotificationPriority {
  low
  medium
  high
}

model Notification {
  id              String                @id @default(uuid())
  userId          String                @map("user_id")
  category        NotificationCategory
  title           String
  message         String
  priority        NotificationPriority  @default(medium)
  readAt          DateTime?             @map("read_at")
  acknowledgedAt  DateTime?             @map("acknowledged_at")
  referenceType   String?               @map("reference_type")
  referenceId     String?               @map("reference_id")
  createdAt       DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "idx_notifications_user_created")
  @@map("notifications")
}

model NotificationPreference {
  id        String                @id @default(uuid())
  userId    String                @map("user_id")
  category  NotificationCategory
  inApp     Boolean               @default(true) @map("in_app")
  email     Boolean               @default(false)
  teams     Boolean               @default(false)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category], map: "uq_notification_preference_user_category")
  @@index([userId], map: "idx_notification_preference_user_id")
