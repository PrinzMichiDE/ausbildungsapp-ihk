# Backend-Konfiguration (Platzhalter – niemals echte Secrets committen)
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Datenbank (PostgreSQL + pgvector)
DATABASE_URL=postgresql://app:app@localhost:5432/nextgen

# JWT (in Produktion zwingend ein starkes Secret)
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# KI-Provider: ollama | openai | openrouter
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
AI_API_KEY=
AI_MODEL=llama3.1
AI_EMBEDDING_MODEL=nomic-embed-text
AI_EMBEDDING_DIMENSIONS=768
AI_QUALITY_THRESHOLD=85

# Microsoft Teams (Adaptive Cards Webhook)
TEAMS_WEBHOOK_URL=

# CORS (kommagetrennte Liste erlaubter Origins)
CORS_ORIGINS=http://localhost:5173

BCRYPT_ROUNDS=12

# --- Prod Docker Compose (docker-compose.prod.yml) ---
DB_PASSWORD=change-me-in-production
APP_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
